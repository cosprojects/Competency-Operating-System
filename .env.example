# AXIONA Beta 1 — пример окружения. Не коммитить реальные секреты.

# Продукт
APP_URL=https://axiona.world
NODE_ENV=production
RELEASE_ID=beta-1
LEGAL_VERSION=1.1.0
# 1 — аварийный стоп публичной регистрации: письма только существующим адресам
AUTH_REGISTRATION_DISABLED=0

# PostgreSQL в РФ
DATABASE_URL=postgresql://axiona:change-me@localhost:5432/axiona

# Секрет для подписи/будущих нужд; сессии хранятся как hash в БД
SESSION_SECRET=change-me-32-bytes-minimum

# Email provider (HTTP JSON API): { to, subject, text, html, from }
EMAIL_API_URL=
EMAIL_API_TOKEN=
# Plan B: SMTP (Yandex). Если EMAIL_SMTP_HOST задан, Resend не используется.
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=465
EMAIL_SMTP_SECURE=true
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=no-reply@axiona.world
SUPPORT_EMAIL=hi.axiona@protonmail.com
# Куда приходят отзывы обратной связи
FEEDBACK_EMAIL=hi.axiona@protonmail.com
PRIVACY_EMAIL=hi.axiona@protonmail.com

# Админы через запятую
ADMIN_EMAILS=founder@example.com

# Соль для хэша IP в анти-спаме; не хранить сырой IP
ANALYTICS_HASH_SALT=change-me

# Только для офлайн-контентного pipeline, не для приложения
# DEEPSEEK_API_KEY=

# Официальные API авто-расширения ресурсной базы (sources:expand), не для приложения.
# Проверка: npm run sources:provider-test -- --provider all
# Google CSE: для новых поисковиков режим «весь интернет» отключён (2026) — поиск только по списку сайтов.
# Для веб-поиска используй Brave Search API (независимый индекс; free ≈1000 запросов/мес):
# BRAVE_API_KEY=
# Google CSE оставлен для сценария «искать только по курируемому списку доменов»:
# GOOGLE_CSE_API_KEY=
# GOOGLE_CSE_CX=
# YouTube: только официальный Data API (поиск ~100 units из 10 000/день). Страницы не скрейпим.
# YOUTUBE_API_KEY=
# GitHub: без токена 10 поисков/мин; токен поднимает лимит.
# GITHUB_TOKEN=
