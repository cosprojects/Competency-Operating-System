# VDS production contour: app.axiona.world
# Copy to .env.production (gitignored) and fill values. Do not commit secrets.

APP_URL=https://app.axiona.world
NODE_ENV=production
RELEASE_ID=beta-1
LEGAL_VERSION=1.1.0
# Срок ссылки для входа, минуты (по умолчанию 43200 = 30 дней)
LOGIN_LINK_TTL_MINUTES=43200
AUTH_REGISTRATION_DISABLED=1
RELEASE_BUILD=release:build

# Database inside Docker network. Password must match POSTGRES_PASSWORD.
POSTGRES_USER=axiona
POSTGRES_DB=axiona
POSTGRES_PASSWORD=change-me-long-random
DATABASE_URL=postgresql://axiona:change-me-long-random@db:5432/axiona

SESSION_SECRET=change-me-32-bytes-minimum
ANALYTICS_HASH_SALT=change-me

# Email provider (HTTP JSON API)
EMAIL_API_URL=
EMAIL_API_TOKEN=
# Plan B: SMTP (Yandex). Если EMAIL_SMTP_HOST задан, Resend не используется.
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=465
EMAIL_SMTP_SECURE=true
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=no-reply@app.axiona.world
SUPPORT_EMAIL=hi.axiona@protonmail.com
PRIVACY_EMAIL=hi.axiona@protonmail.com
FEEDBACK_EMAIL=hi.axiona@protonmail.com

# Owner by email until UserRole phase 1
OWNER_EMAILS=
ADMIN_EMAILS=
