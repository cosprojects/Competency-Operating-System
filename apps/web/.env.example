# Локальная разработка (Next.js читает apps/web/.env.local)
APP_URL=http://localhost:3000
LEGAL_VERSION=1.0.0
ADMIN_EMAILS=you@example.com
ANALYTICS_HASH_SALT=local-dev
SESSION_SECRET=local-dev-32-bytes-minimum

# Локально БД не нужна: npm run db:local собирает SQLite client.
# Для PostgreSQL-контура:
# DATABASE_URL=postgresql://user:pass@localhost:5432/axiona

# Email: локально не задан — ссылка печатается в консоль.
# EMAIL_API_URL=
# EMAIL_API_TOKEN=
# EMAIL_FROM=no-reply@axiona.world
