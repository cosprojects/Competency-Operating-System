{
  "name": "axiona-cos-mvp",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "AXIONA / Competency Operating System — Evidence-First competency pipeline (DeepSeek Guarded Engine)",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "changelog:collect": "node --experimental-strip-types scripts/changelog/collect.ts",
    "changelog:apply": "node --experimental-strip-types scripts/changelog/apply.ts",
    "changelog:check": "node --experimental-strip-types scripts/changelog/apply.ts -- --check",
    "agents:check": "sh scripts/check-agent-assets.sh",
    "figma:compare": "node scripts/web/figma-compare.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "catalog:validate": "node --experimental-strip-types src/methodology/v1/competency/cli/catalog.ts",
    "canonical:validate": "node --experimental-strip-types src/methodology/v1/competency/cli/canonical-validate.ts",
    "canonical:report": "node --experimental-strip-types src/methodology/v1/competency/cli/canonical-validate.ts -- --report",
    "materials:agent:queue": "node --experimental-strip-types src/methodology/v1/materials-agent/cli/queue.ts",
    "model:sync": "node --experimental-strip-types src/methodology/v1/competency/model/cli/sync.ts",
    "model:validate": "node --experimental-strip-types src/methodology/v1/competency/model/cli/validate.ts",
    "model:views": "node --experimental-strip-types src/methodology/v1/competency/model/cli/views.ts",
    "materials:agent:review": "node --experimental-strip-types src/methodology/v1/materials-agent/cli/review.ts",
    "learning:validate": "node --experimental-strip-types src/methodology/v1/learning-sources/cli/validate.ts",
    "learning:audit": "node --experimental-strip-types src/methodology/v1/learning-sources/cli/audit.ts",
    "learning:map": "node --experimental-strip-types src/methodology/v1/learning-sources/cli/map.ts",
    "learning:topics": "node --experimental-strip-types src/methodology/v1/learning-sources/cli/topics.ts",
    "release:report": "node --experimental-strip-types scripts/release/validate.ts -- --release beta-1 --report --allow-draft",
    "release:validate": "node --experimental-strip-types scripts/release/validate.ts -- --release beta-1",
    "release:validate:draft": "node --experimental-strip-types scripts/release/validate.ts -- --release beta-1 --allow-draft",
    "release:build": "node --experimental-strip-types scripts/release/build.ts -- --release beta-1",
    "release:build:draft": "node --experimental-strip-types scripts/release/build.ts -- --release beta-1 --allow-draft",
    "web:dev": "npm --workspace apps/web run dev",
    "web:build": "npm run release:build:draft && npm --workspace apps/web run build",
    "web:build:release": "npm run release:validate && npm run release:build && npm --workspace apps/web run build",
    "web:start": "npm --workspace apps/web run start",
    "web:typecheck": "npm run release:build:draft && npm --workspace apps/web run typecheck",
    "db:deploy": "prisma migrate deploy",
    "metrics:report": "node --experimental-strip-types scripts/metrics/report.ts",
    "finance:model": "node --experimental-strip-types scripts/business-model/financial-model.ts",
    "db:local:prepare": "node --experimental-strip-types scripts/dev/local-schema.ts",
    "db:local:push": "prisma db push --schema prisma/schema.local.prisma --skip-generate",
    "db:local:generate": "prisma generate --schema prisma/schema.local.prisma",
    "db:local": "npm run db:local:prepare && npm run db:local:push && npm run db:local:generate",
    "learning:aggregate": "node --experimental-strip-types src/methodology/v1/learning-sources/cli/aggregate.ts",
    "sources:expand": "node --experimental-strip-types src/methodology/v1/learning-sources/cli/expand.ts",
    "sources:provider-test": "node --experimental-strip-types src/methodology/v1/learning-sources/cli/provider-test.ts",
    "materials:accept": "node --experimental-strip-types src/methodology/v1/materials-agent/cli/accept.ts",
    "materials:verify": "node --experimental-strip-types src/methodology/v1/materials-agent/cli/verify.ts",
    "materials:coverage": "node --experimental-strip-types src/methodology/v1/materials-agent/cli/coverage.ts",
    "reviews:export": "node --experimental-strip-types scripts/reviews/export.ts",
    "reviews:decide": "node --experimental-strip-types scripts/reviews/decide.ts",
    "sources:remove": "node --experimental-strip-types src/methodology/v1/learning-sources/cli/remove.ts",
    "sources:access": "node --experimental-strip-types src/methodology/v1/learning-sources/cli/access.ts",
    "sources:repair": "node --experimental-strip-types src/methodology/v1/learning-sources/cli/repair.ts",
    "aggregate": "node --experimental-strip-types scripts/aggregate/index.ts",
    "materials:daily": "node --experimental-strip-types src/methodology/v1/materials-agent/cli/daily.ts",
    "descriptions:agent": "node --experimental-strip-types src/methodology/v1/competency/cli/descriptions-agent.ts",
    "descriptions:validate": "node --experimental-strip-types src/methodology/v1/competency/cli/descriptions-validate.ts",
    "tasks:list": "node --experimental-strip-types scripts/tasks/cli.ts list",
    "tasks:add": "node --experimental-strip-types scripts/tasks/cli.ts add",
    "tasks:sync": "node --experimental-strip-types scripts/tasks/cli.ts sync",
    "tasks:doctor": "node --experimental-strip-types scripts/tasks/cli.ts doctor",
    "contracts:validate": "node --experimental-strip-types src/methodology/v1/contracts/cli/validate.ts",
    "run:cli": "node --experimental-strip-types src/methodology/v1/workflow/cli/run.ts",
    "review:shadow": "node --experimental-strip-types src/methodology/v1/review/cli/shadow.ts",
    "tasks:project": "node --experimental-strip-types scripts/tasks/project.ts",
    "materials:import-ledger": "node --experimental-strip-types scripts/materials/import-ledger.ts",
    "release:promote": "node --experimental-strip-types scripts/release/promote.ts",
    "release:publications": "node --experimental-strip-types scripts/release/publications.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.4.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "prisma": "^6.4.0",
    "typescript": "^5.7.3"
  },
  "workspaces": [
    "apps/web"
  ]
}
