// AXIONA Beta 1 — минимальная схема пользовательских данных.
// Контент живёт в JSON-модели и не дублируется в БД.
// Будущая диагностическая схема сохранена в prisma/assessment.schema.prisma.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FavoriteTarget {
  COMPETENCY
  SOURCE
}

enum StudyStatusValue {
  NOT_STARTED
  LEARNING
  LEARNED
}

enum FeedbackType {
  CONTENT_ERROR
  MISSING_COMPETENCY
  BAD_MATERIAL
  MISSING_FEATURE
  IMPROVEMENT
  GENERAL
}

enum FeedbackStatus {
  NEW
  TRIAGED
  RESOLVED
}

enum ConsentKind {
  TERMS
  PRIVACY
  ANALYTICS
  MARKETING
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  createdAt DateTime  @default(now())
  lastSeenAt DateTime?
  deletedAt DateTime?

  sessions  Session[]
  favorites Favorite[]
  statuses  StudyStatus[]
  feedback  Feedback[]
  consents  ConsentRecord[]
  events    AnalyticsEvent[]

  @@index([createdAt])
}

model LoginToken {
  id        String    @id @default(cuid())
  email     String
  tokenHash      String    @unique
  returnTo       String?
  consentVersion String?
  expiresAt      DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email, createdAt])
  @@index([expiresAt])
}

model Session {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime?

  @@index([userId])
  @@index([expiresAt])
}

model Favorite {
  id         String         @id @default(cuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetType FavoriteTarget
  targetId   String
  createdAt  DateTime       @default(now())

  @@unique([userId, targetType, targetId])
  @@index([userId, createdAt])
}

model StudyStatus {
  id           String           @id @default(cuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  competencyId String
  status       StudyStatusValue @default(NOT_STARTED)
  updatedAt    DateTime         @updatedAt

  @@unique([userId, competencyId])
  @@index([userId, status])
}

model Feedback {
  id           String          @id @default(cuid())
  userId       String?
  user         User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  type         FeedbackType
  targetType   FavoriteTarget?
  targetId     String?
  rating       Int?
  comment      String?
  contactEmail String?
  pagePath     String
  status       FeedbackStatus @default(NEW)
  createdAt    DateTime        @default(now())
  resolvedAt   DateTime?

  @@index([status, createdAt])
  @@index([type, createdAt])
  @@index([targetType, targetId])
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  name      String
  anonId    String?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  path      String?
  props     Json?
  createdAt DateTime @default(now())

  @@index([name, createdAt])
  @@index([anonId, createdAt])
  @@index([userId, createdAt])
}

model ConsentRecord {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      ConsentKind
  version   String
  grantedAt DateTime    @default(now())
  revokedAt DateTime?

  @@unique([userId, kind, version])
  @@index([userId, kind, grantedAt])
}
