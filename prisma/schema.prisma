// AXIONA Beta 1 — минимальная схема пользовательских данных.
// Контент живёт в JSON-модели и не дублируется в БД.
// Будущая диагностическая схема сохранена в prisma/assessment.schema.prisma.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FavoriteTarget {
  COMPETENCY
  SOURCE
  PROFESSION
}

enum StudyStatusValue {
  NOT_STARTED
  LEARNING
  LEARNED
}

enum FeedbackType {
  CONTENT_ERROR
  MISSING_COMPETENCY
  BAD_MATERIAL
  MISSING_FEATURE
  IMPROVEMENT
  GENERAL
}

enum FeedbackStatus {
  NEW
  TRIAGED
  RESOLVED
}

enum SourceReviewAction {
  CONFIRM
  BLOCK
}

enum SourceReviewReason {
  OFF_TOPIC
  UNRELIABLE
  BROKEN
  LOCKED
  OTHER
}

enum ConsentKind {
  TERMS
  PRIVACY
  ANALYTICS
  MARKETING
}

model User {
  id         String    @id @default(cuid())
  email      String    @unique
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime?
  deletedAt  DateTime?

  sessions          Session[]
  favorites         Favorite[]
  statuses          StudyStatus[]
  feedback          Feedback[]
  sourceReviews     SourceReview[]
  sourceViews       SourceView[]
  materialDecisions MaterialDecision[]
  consents          ConsentRecord[]
  events            AnalyticsEvent[]

  @@index([createdAt])
}

model LoginToken {
  id             String    @id @default(cuid())
  email          String
  tokenHash      String    @unique
  /// login | email_change | invite
  purpose        String    @default("login")
  /// Новый адрес для email_change
  newEmail       String?
  returnTo       String?
  consentVersion String?
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime  @default(now())

  @@index([email, createdAt])
  @@index([expiresAt])
}

model Session {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime?

  @@index([userId])
  @@index([expiresAt])
}

model Favorite {
  id         String         @id @default(cuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetType FavoriteTarget
  targetId   String
  createdAt  DateTime       @default(now())

  @@unique([userId, targetType, targetId])
  @@index([userId, createdAt])
}

model StudyStatus {
  id           String           @id @default(cuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  competencyId String
  status       StudyStatusValue @default(NOT_STARTED)
  updatedAt    DateTime         @updatedAt

  @@unique([userId, competencyId])
  @@index([userId, status])
}

model Feedback {
  id           String          @id @default(cuid())
  userId       String?
  user         User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  type         FeedbackType
  targetType   FavoriteTarget?
  targetId     String?
  rating       Int?
  comment      String?
  contactEmail String?
  pagePath     String
  status       FeedbackStatus  @default(NEW)
  createdAt    DateTime        @default(now())
  resolvedAt   DateTime?

  @@index([status, createdAt])
  @@index([type, createdAt])
  @@index([targetType, targetId])
}

model SourceReview {
  id           String              @id @default(cuid())
  sourceId     String
  competencyId String
  /**
   * competency — голос за материал в контексте компетенции; source — сигнал на источник целиком.
   */
  scope        String              @default("competency")
  action       SourceReviewAction
  reason       SourceReviewReason?
  comment      String?
  userId       String
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  /**
   * u:<userId> — один голос на пару «ресурс × компетенция».
   */
  actorKey     String
  pagePath     String
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([sourceId, competencyId, actorKey])
  @@index([sourceId, competencyId, action])
  @@index([createdAt])
}

/// Просмотр материала пользователем (COS-EAR-013): отмечается при переходе к источнику.
model SourceView {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceId      String
  firstViewedAt DateTime @default(now())
  lastViewedAt  DateTime @default(now())

  @@unique([userId, sourceId])
  @@index([sourceId])
  @@index([userId, lastViewedAt])
}

enum MaterialDecisionAction {
  APPROVE
  BLOCK
}

/// Финальное решение владельца по материалу (COS-EAR-014).
model MaterialDecision {
  id         String                 @id @default(cuid())
  sourceId   String
  action     MaterialDecisionAction
  reason     String?
  actorId    String?
  actor      User?                  @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt  DateTime               @default(now())
  revokedAt  DateTime?

  @@index([sourceId, createdAt])
  @@index([action, createdAt])
}

/// Журнал админ-действий (COS-ARCH-173, T-040).
model AdminAudit {
  id         String   @id @default(cuid())
  actorId    String?
  actorEmail String
  action     String
  targetType String
  targetId   String?
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([action, createdAt])
  @@index([actorId, createdAt])
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  name      String
  anonId    String?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  path      String?
  props     Json?
  createdAt DateTime @default(now())

  @@index([name, createdAt])
  @@index([anonId, createdAt])
  @@index([userId, createdAt])
}

model ConsentRecord {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      ConsentKind
  version   String
  grantedAt DateTime    @default(now())
  revokedAt DateTime?

  @@unique([userId, kind, version])
  @@index([userId, kind, grantedAt])
}

// ---- COS-ARCH-170: рантайм конвейера онтологии ---------------------------------
// Контент и онтология остаются в JSON-модели; в БД живёт только состояние прогонов.

enum WorkflowRunStatus {
  CREATED
  RUNNING
  AWAITING_REVIEW
  SUCCEEDED
  PARTIALLY_SUCCEEDED
  FAILED
  CANCELLED
}

enum WorkflowStepStatus {
  PENDING
  RUNNING
  AWAITING_REVIEW
  SUCCEEDED
  FAILED
  SKIPPED
  BLOCKED
}

model WorkflowArtifact {
  id          String   @id
  kind        String
  uri         String
  sha256      String   @unique
  bytes       Int
  contentType String?
  createdAt   DateTime @default(now())

  inputs  WorkflowStep[] @relation("StepInput")
  outputs WorkflowStep[] @relation("StepOutput")
}

model WorkflowRun {
  id              String            @id
  pipelineId      String
  pipelineVersion String
  status          WorkflowRunStatus
  paramsJson      String            @default("{}")
  maxCostUsd      Float?
  spentUsd        Float             @default(0)
  createdAt       DateTime          @default(now())
  startedAt       DateTime?
  finishedAt      DateTime?
  steps           WorkflowStep[]

  @@index([createdAt])
  @@index([status, createdAt])
}

model WorkflowStep {
  id              String             @id
  runId           String
  run             WorkflowRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  stage           String
  agent           String
  status          WorkflowStepStatus
  attempt         Int                @default(1)
  position        Int
  idempotencyKey  String
  contractVersion String
  inputRefId      String?
  inputRef        WorkflowArtifact?  @relation("StepInput", fields: [inputRefId], references: [id])
  outputRefId     String?
  outputRef       WorkflowArtifact?  @relation("StepOutput", fields: [outputRefId], references: [id])
  startedAt       DateTime?
  finishedAt      DateTime?
  tokens          Int?
  costUsd         Float?
  latencyMs       Int?
  errorCode       String?
  errorMessage    String?
  errorRetryable  Boolean?

  @@unique([runId, stage, attempt])
  @@index([idempotencyKey])
  @@index([runId, position])
}

// ---- COS-ARCH-172/173: материалы, привязки и решения приёмки --------------

enum ReviewOutcome {
  AUTO_ACCEPT
  BADGE
  QUARANTINE
  QUEUE
  AUTO_REJECT
}

/// Канонический ресурс: один URL — один материал, id = material_<sha1(canonicalUrl)>.
model Material {
  id           String         @id
  canonicalUrl String         @unique
  url          String
  title        String
  provider     String?
  createdAt    DateTime       @default(now())
  links        MaterialLink[]

  @@index([createdAt])
}

/// Привязка материала к компетенции. Уникальность пары — защита от дублей связей.
model MaterialLink {
  id         String   @id @default(cuid())
  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  nodeId     String
  createdAt  DateTime @default(now())

  @@unique([materialId, nodeId])
  @@index([nodeId])
}

/// Решение политики приёмки по материалу — журнал для аудита и калибровки порогов.
model ReviewDecision {
  id            String        @id @default(cuid())
  runId         String
  stepId        String
  materialUrl   String
  title         String?
  competencyId  String?
  outcome       ReviewOutcome
  decision      String
  reason        String
  policyVersion String
  signalsJson   String?
  createdAt     DateTime      @default(now())

  @@index([runId])
  @@index([outcome, createdAt])
  @@index([materialUrl])
}
