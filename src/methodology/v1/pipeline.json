{
  "version": "1.0.0",
  "log": "data/competency-candidates/pipeline-run.json",
  "steps": [
    {
      "id": "test",
      "order": 1,
      "title": "Тесты",
      "description": "Проверяет парсер, профиль, методолога и расчёт прогресса до сетевых вызовов.",
      "executor": "agent",
      "command": "npm",
      "args": [
        "test"
      ]
    },
    {
      "id": "typecheck",
      "order": 2,
      "title": "Проверка типов",
      "description": "Останавливает пайплайн, если TypeScript не сходится.",
      "executor": "agent",
      "command": "npm",
      "args": [
        "run",
        "typecheck"
      ]
    },
    {
      "id": "parse-candidates",
      "order": 3,
      "title": "Очередь кандидатов",
      "description": "Собирает формулировки ESCO по открытым профессиям. O*NET добавляется при наличии ONET_API_KEY. Граф не меняется.",
      "executor": "agent",
      "command": "npm",
      "args": [
        "run",
        "parse:candidates"
      ],
      "produces": "data/competency-candidates/queue.json"
    },
    {
      "id": "program-extract",
      "order": 4,
      "title": "Программы дизайнерских профессий",
      "description": "Извлекает профессии дизайна и их навыки со страниц Яндекс Практикума (robots.txt: без query). Пишет журнал источников, граф не меняет.",
      "executor": "agent",
      "command": "npm",
      "args": [
        "run",
        "program:extract"
      ],
      "produces": "data/profile/practicum-design.json"
    },
    {
      "id": "profile-build",
      "order": 5,
      "title": "Профиль профессии",
      "description": "Собирает дерево компетенций из занятий ESCO по эталонной таксономии и курируемому маппингу. Показывает подтверждённые листья, пробелы и навыки вне области. В граф не пишет.",
      "executor": "agent",
      "command": "npm",
      "args": [
        "run",
        "profile:build",
        "--",
        "--profession",
        "uxui"
      ],
      "produces": "data/profile/uxui.json"
    },
    {
      "id": "methodologist-patch",
      "order": 6,
      "title": "Патч методолога",
      "description": "Раскладывает очередь по узлам графа. Якоря не сочиняет. В граф не пишет.",
      "executor": "agent",
      "command": "npm",
      "args": [
        "run",
        "methodologist:patch"
      ],
      "requires": [
        "data/competency-candidates/queue.json"
      ],
      "produces": "data/competency-candidates/methodologist-patch.json"
    },
    {
      "id": "accept-patch",
      "order": 7,
      "title": "Приёмка патча",
      "description": "Человек переносит принятые требования в граф и поднимает methodologyVersion. Агент этот шаг не выполняет.",
      "executor": "human",
      "command": "",
      "args": [],
      "requires": [
        "data/competency-candidates/methodologist-patch.json"
      ]
    },
    {
      "id": "competency-professions",
      "order": 8,
      "title": "IT-профессии",
      "description": "Собирает целевые IT-профессии из ESCO и O*NET.",
      "executor": "agent",
      "command": "npm",
      "args": [
        "run",
        "professions:collect",
        "--",
        "--domain",
        "it"
      ],
      "produces": "data/competency/professions-it.json"
    },
    {
      "id": "competency-tags",
      "order": 9,
      "title": "Теги профессий",
      "description": "Собирает навыки и знания IT-профессий из источников.",
      "executor": "agent",
      "command": "npm",
      "args": [
        "run",
        "tags:collect",
        "--",
        "--domain",
        "it"
      ],
      "requires": [
        "data/competency/professions-it.json"
      ],
      "produces": "data/competency/tags-it.json"
    },
    {
      "id": "competency-candidates",
      "order": 10,
      "title": "Кандидаты в компетенции",
      "description": "LLM предлагает группы тегов; скрипт валидирует.",
      "executor": "agent",
      "command": "npm",
      "args": [
        "run",
        "competency:candidates",
        "--",
        "--domain",
        "it"
      ],
      "requires": [
        "data/competency/tags-it.json"
      ],
      "requiresEnv": [
        "DEEPSEEK_API_KEY"
      ],
      "produces": "data/competency/candidates-it.json"
    },
    {
      "id": "competency-blocks",
      "order": 11,
      "title": "Блоки компетенций",
      "description": "LLM предлагает компоненты и теги; скрипт валидирует.",
      "executor": "agent",
      "command": "npm",
      "args": [
        "run",
        "competency:build",
        "--",
        "--domain",
        "it"
      ],
      "requires": [
        "data/competency/candidates-it.json"
      ],
      "requiresEnv": [
        "DEEPSEEK_API_KEY"
      ],
      "produces": "data/competency/blocks-it.json"
    },
    {
      "id": "competency-review",
      "order": 12,
      "title": "Проверка блоков",
      "description": "Человек принимает блоки в каталог. Агент этого не делает.",
      "executor": "human",
      "command": "",
      "args": [],
      "requires": [
        "data/competency/blocks-it.json"
      ]
    },
    {
      "id": "catalog-validate",
      "order": 13,
      "title": "Валидация каталога",
      "description": "Проверяет принятый каталог компетенций.",
      "executor": "agent",
      "command": "npm",
      "args": [
        "run",
        "catalog:validate",
        "--",
        "--domain",
        "it"
      ],
      "requires": [
        "src/methodology/v1/competency/catalog/it.json"
      ]
    },
    {
      "id": "materials-collect",
      "order": 14,
      "title": "Материалы компетенций",
      "description": "Собирает статьи, курсы и видео из открытых источников; платные — только метаданные.",
      "executor": "agent",
      "command": "npm",
      "args": [
        "run",
        "materials:collect",
        "--",
        "--domain",
        "it"
      ],
      "requires": [
        "data/competency/blocks-it.json"
      ],
      "produces": "data/competency/materials-it.json"
    },
    {
      "id": "materials-classify",
      "order": 15,
      "title": "Сопоставление материалов",
      "description": "LLM сопоставляет материалы с компетенциями; скрипт валидирует.",
      "executor": "agent",
      "command": "npm",
      "args": [
        "run",
        "materials:classify",
        "--",
        "--domain",
        "it"
      ],
      "requires": [
        "data/competency/materials-it.json"
      ],
      "requiresEnv": [
        "DEEPSEEK_API_KEY"
      ],
      "produces": "data/competency/materials-classified-it.json"
    },
    {
      "id": "materials-review",
      "order": 16,
      "title": "Проверка материалов",
      "description": "Человек принимает материалы и связи.",
      "executor": "human",
      "command": "",
      "args": [],
      "requires": [
        "data/competency/materials-classified-it.json"
      ]
    },
    {
      "id": "materials-validate",
      "order": 17,
      "title": "Валидация материалов",
      "description": "Проверяет покрытие, доступ и ссылки.",
      "executor": "agent",
      "command": "npm",
      "args": [
        "run",
        "materials:validate",
        "--",
        "--domain",
        "it",
        "--require-coverage"
      ],
      "requires": [
        "data/competency/materials-classified-it.json"
      ]
    }
  ]
}
