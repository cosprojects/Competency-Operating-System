# Скопируй в tasks/.env.local (gitignored) и заполни.
# Fine-grained PAT: repository access, Issues read/write, Projects read/write (если нужны поля), Metadata read.
GH_TOKEN=

# Номер проекта GitHub Projects v2; нужен для будущей синхронизации полей.
# Можно найти в URL проекта: https://github.com/users/cosprojects/projects/<NUMBER>
GITHUB_PROJECT_NUMBER=

# Classic PAT (scopes: public_repo, project) — только для Project API.
# Нужен для добавления существующих issues и заполнения полей Project.
PROJECT_TOKEN=

# По умолчанию берётся из tasks/tasks.json.
# GITHUB_PROJECT_OWNER=cosprojects
# GITHUB_PROJECT_TITLE=AXIONA Launch
